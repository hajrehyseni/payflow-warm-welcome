# PayFlow — environment template
# Copy to `.env.local` for local secrets (`.env.local` is gitignored via *.local).
# The committed `.env` only contains CLIENT-SAFE publishable keys (VITE_* values
# are bundled into the browser by design, so they are public).

# ─────────────────────────────────────────────────────────────
# Client-safe (publishable) — shipped to the browser. Safe to commit.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Mirrored non-VITE copies used by the server build
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Stripe publishable token for the payments client (pk_… — client-safe)
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_your_publishable_token

# ─────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — DO NOT COMMIT. Set these in the hosting
# platform (Lovable / Supabase Edge Function secrets), never in a
# tracked file. Listed here for documentation only.
# ─────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=set_in_hosting_platform
# STRIPE_SECRET_KEY=set_in_hosting_platform
# STRIPE_LIVE_API_KEY=set_in_hosting_platform
# STRIPE_SANDBOX_API_KEY=set_in_hosting_platform
# LOVABLE_API_KEY=set_in_hosting_platform
# DATABASE_URL=set_in_hosting_platform
